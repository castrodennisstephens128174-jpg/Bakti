PORT=3005
NEXT_PUBLIC_APP_NAME=Bakti
NEXT_PUBLIC_APP_URL=http://localhost:3005
DRIZZLE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bakti

# Setting ONLY these two switches the whole app's network — Horizon, Soroban RPC,
# passphrase, contract id, native SAC, and USDC issuer all resolve from this in
# src/server/config/env.ts / env.public.ts. Mainnet is the product default.
# For free local dev/testing, set both to `testnet` in your own .env.local — do
# NOT also uncomment the overrides below, or you'll get mainnet values with a
# testnet label (real funds, mislabeled network).
STELLAR_NETWORK=public
NEXT_PUBLIC_STELLAR_NETWORK=public
BAKTI_ADMIN_PUBLIC_KEY=GBL5RJKF4QNJ4ZPLJZ7PS7K5A4J44VEZJRV2CRTFFDRVSY2N76AIIE47
USDC_ASSET_CODE=USDC
NEXT_PUBLIC_USDC_CODE=USDC

# Explicit per-value overrides — leave commented out. Only uncomment one if you
# specifically need to pin that value regardless of STELLAR_NETWORK (e.g. a
# custom RPC provider); each line here wins over the network-derived default.
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
# SOROBAN_BAKTI_CONTRACT_ID=CBVAZDK2GAX5MJ7SSSQKRLY33TO7Q6DG3ZGZK6WMZSGI63XRMIR2CTHR
# NEXT_PUBLIC_BAKTI_CONTRACT_ID=CBVAZDK2GAX5MJ7SSSQKRLY33TO7Q6DG3ZGZK6WMZSGI63XRMIR2CTHR
# NATIVE_SAC_ID=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# USDC_ASSET_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Reserved configuration only. No anchor deposit route or muxed payment destination is wired.
ANCHOR_COLLECTION_PUBLIC_KEY=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# SEP-1/10/12/31 anchor client (src/server/stellar/anchor). Leave both unset in
# production. For the testnet Anchor Platform stand-in (see anchor-platform/README.md):
# ANCHOR_HOME_DOMAIN=localhost:8180
# SECRET_ANCHOR_SIGNING_SEED=<a funded testnet S... secret, never a mainnet key>

# Self-hosted SEP-1/10/12/31 anchor stub (src/server/service/anchor-server.service.ts),
# served by this same app at /.well-known/stellar.toml + /api/anchor/*. Lets a
# testnet Vercel deploy demo the full SEP-31 round trip without any external
# anchor or local docker. Testnet-only; leave unset in production.
# ANCHOR_STUB_SERVER_SIGNING_SEED=<a testnet S... secret, never a mainnet key>


SESSION_SECRET=change-me-at-least-32-characters-long-string
SESSION_COOKIE_NAME=bakti_session
SESSION_TTL_SECONDS=604800
NONCE_TTL_SECONDS=300

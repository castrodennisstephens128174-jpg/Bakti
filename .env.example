PORT=3005
NEXT_PUBLIC_APP_NAME=Bakti
NEXT_PUBLIC_APP_URL=http://localhost:3005
DRIZZLE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bakti

# Setting ONLY these two switches this deployment's home network — Horizon,
# Soroban RPC, passphrase, contract id, native SAC, and USDC issuer all resolve
# from src/shared/network-config.ts via src/server/stellar/network.ts.
# Mainnet ("public") is the product default. For local dev/testing, set both
# to `testnet` in your own .env.local.
STELLAR_NETWORK=public
NEXT_PUBLIC_STELLAR_NETWORK=public
BAKTI_ADMIN_PUBLIC_KEY=GBL5RJKF4QNJ4ZPLJZ7PS7K5A4J44VEZJRV2CRTFFDRVSY2N76AIIE47
USDC_ASSET_CODE=USDC
NEXT_PUBLIC_USDC_CODE=USDC

# Explicit per-value overrides — leave commented out. Only uncomment one if you
# specifically need to pin that value regardless of STELLAR_NETWORK (e.g. a
# custom RPC provider or a newly-redeployed contract); each line wins over the
# network preset in src/shared/network-config.ts.
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
# SOROBAN_BAKTI_CONTRACT_ID=CBVAZDK2GAX5MJ7SSSQKRLY33TO7Q6DG3ZGZK6WMZSGI63XRMIR2CTHR
# NEXT_PUBLIC_BAKTI_CONTRACT_ID=CBVAZDK2GAX5MJ7SSSQKRLY33TO7Q6DG3ZGZK6WMZSGI63XRMIR2CTHR
# NATIVE_SAC_ID_TESTNET=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# USDC_ASSET_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# SEP-31 partner-anchor integration + automated keeper. This contract build adds
# release(schedule_id, caller, memo) + set_recipient — NOT YET deployed to
# mainnet (the live mainnet contract still runs the pre-memo ABI; see
# contracts/DEPLOYMENT.md). Leave unset until a v2 contract is redeployed on
# the target network. Testnet-only today, verified against bakti-anchor/.
# SEP31_ANCHOR_DOMAIN=localhost:3006
# SEP31_SENDING_SECRET=<Bakti's own SEP-10 auth key for the anchor, testnet only>
# SEP31_CALLBACK_URL=https://<this-deploy>/api/sep31/callback

# Keeper channel keys (comma-separated Stellar secrets, testnet only). The
# keeper signs + submits `release` on a cron for escrow-backed SEP-31
# allowances; the contract enforces amount/destination/cadence regardless of
# which key calls it.
# KEEPER_SECRETS=<S...,S...>
# CRON_SECRET=<shared secret the cron routes require as a bearer token>
# TESTNET DEMO ONLY: keeper periods tick per-minute/per-N-seconds instead of
# per-month, so a multi-month plan plays out in seconds.
# KEEPER_FAST_PERIODS=true

# AES-256-GCM key (32 bytes, hex) encrypting the KYC blob at rest
# (allowances.kyc_json). Generate with: openssl rand -hex 32
# KYC_ENCRYPTION_KEY=<64 hex chars>

# Alert webhook for reconciliation mismatches (optional).
# ALERT_WEBHOOK_URL=https://...

SESSION_SECRET=change-me-at-least-32-characters-long-string
SESSION_COOKIE_NAME=bakti_session
SESSION_TTL_SECONDS=604800
NONCE_TTL_SECONDS=300
